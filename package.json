{
  "name": "takam-tender-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild client/main.tsx --bundle --minify --outdir=dist --entry-names=app",
    "dev": "npm run build && npm start",
    "start": "tsx server/main.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.20.6",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/yauzl": "2.10.3",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
